{
  "name": "nit-mcp-hudu",
  "version": "1.0.0",
  "description": "Hudu MCP Server for Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
