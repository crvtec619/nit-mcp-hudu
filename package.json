  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.95.0"
  }
}
