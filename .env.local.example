# Hudu local write connector
# Copy to .env.local (gitignored) and fill in real values. Never commit .env.local.

# Hudu API base URL (same as the worker).
HUDU_BASE_URL=https://docs.networkzit.com/api/v1

# Hudu API key with create/edit scope. This key can write to all company
# documentation, which is in GxP / Part 11 / HIPAA scope. Keep it local.
HUDU_API_KEY=<your-hudu-api-key>

# Optional safety knob. Comma-separated company IDs. When set, every write tool
# that targets a company refuses any company_id not in this list. Leave unset
# for full write access across all companies.
# HUDU_WRITE_ALLOWLIST=64,12

# Optional. Path to the JSONL write audit log. One line per create/update.
# Defaults to ./audit/hudu-writes.jsonl when unset.
# HUDU_AUDIT_LOG=./audit/hudu-writes.jsonl

# Optional. Tool profile: build | data | ops | all. Controls which tools load.
# The bin/hudu-{build,data,ops}.sh launchers set this for you; set it here only
# when running `npm run local` directly. Unset = all.
# HUDU_PROFILE=build
