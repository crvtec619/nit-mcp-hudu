# Hudu local-dev environment
# Copy to .env.local and fill in real values. Never commit .env.local.

HUDU_BASE_URL=https://docs.networkzit.com/api/v1
HUDU_API_KEY=<your-hudu-api-key>

# Required guardrail: every write tool on this branch refuses to run
# unless the request's company_id matches this value. Point it at the
# dedicated "MCP Sandbox" company in Hudu.
HUDU_TEST_COMPANY_ID=<sandbox-company-id>
